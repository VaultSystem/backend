ENVIRONMENT=dev
DEBUG=true

SECRET_KEY=replace-with-a-long-random-jwt-signing-secret
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MASTER_KEY=replace-with-base64-encoded-32-byte-master-key

ALLOWED_HOSTS=["*"]
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true

POSTGRES_USER=vault
POSTGRES_PASSWORD=vault
POSTGRES_DB=vault
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_SECRET_VALUE_BYTES=65536
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
